# Public URL of the deployed invitation, used for link-preview images (og:image).
SITE_URL=https://undangan.example.com

# Supabase project (Settings → API). Server-only: do NOT prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key. Never the service-role / secret key.
SUPABASE_PUBLISHABLE_KEY=

# Optional. "memory" keeps RSVPs in server memory (lost on restart) — for local
# development or previews without Supabase. Defaults to memory in `next dev`
# when Supabase isn't configured; production requires Supabase.
# RSVP_STORAGE=memory
